{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terms.schema.json",
  "type": "object",
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "iast": {"type": "string", "minLength": 1},
          "gloss": {"$ref": "common.schema.json#/$defs/ltext"},
          "concept": {"$ref": "common.schema.json#/$defs/id"},
          "aliases": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "iast", "gloss"],
        "additionalProperties": false
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "headword": {"type": "string"},
          "note": {"$ref": "common.schema.json#/$defs/ltext"}
        },
        "required": ["id", "headword", "note"],
        "additionalProperties": false
      }
    }
  },
  "required": ["terms", "glossary"],
  "additionalProperties": false
}
