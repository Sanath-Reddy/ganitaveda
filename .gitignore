.dart_tool/
.packages
*.iml
.idea/
.fvm/flutter_sdk
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.jks
# Signing keys never live in the repo
*.key
keys/
# Generated by `python -m tools.pack bundle`
apps/mobile/assets/packs/
apps/mobile/lib/l10n/app_localizations*.dart
